APP_NAME="Product Image Discovery Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Junior-friendly local smoke test setup.
# For a fresh Laravel app, create database/database.sqlite and keep these values.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Package config.
PRODUCT_IMAGE_DISCOVERY_ROUTE_PREFIX=api/product-image-discovery
PRODUCT_IMAGE_DISCOVERY_STORAGE_DISK=local

# Sanctum / local API testing.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost

# Optional live search provider credentials.
# The package stores provider credentials in product_image_search_providers.
# Use these env values when you seed or activate providers in your host app.
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# Optional sidecar contract tests.
SIDECAR_E2E_URL=http://127.0.0.1:3100
SIDECAR_E2E_FIXTURE_URL=https://www.nike.com/t/air-force-1-07-mens-shoes-jBrhbr

# Optional future AI / vision providers.
# The current core pipeline does not require AI. These keys are reserved for
# AI-assisted verification, enhancement and description generation.
PRODUCT_IMAGE_DISCOVERY_AI_ENABLED=false
PRODUCT_IMAGE_DISCOVERY_AI_PROVIDER=anthropic
PRODUCT_IMAGE_DISCOVERY_AI_VISION_MODEL=
PRODUCT_IMAGE_DISCOVERY_AI_DESCRIPTION_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
